name: Build Klaytor Android APK

on:
  push:
    branches:
      - main
      - master
  workflow_dispatch:

jobs:
  build-apk:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Source Code
        uses: actions/checkout@v4

      - name: Setup Node.js 20
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Install Project Dependencies
        run: |
          npm install
          npm install express dotenv cookie-parser recharts
          npm install -D @types/express @types/cookie-parser

      - name: Install Capacitor
        run: |
          npm install @capacitor/core@6
          npm install @capacitor/android@6
          npm install --save-dev @capacitor/cli@6

      - name: Create Capacitor Config
        run: |
          cat > capacitor.config.json <<'EOF'
          {
            "appId": "com.klaytor.app",
            "appName": "Klaytor",
            "webDir": "dist",
            "server": {
              "androidScheme": "https"
            }
          }
          EOF

      - name: Setup Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - name: Setup Android SDK
        uses: android-actions/setup-android@v3

      - name: Build Klaytor Web App
        run: npm run build

      - name: Create Android Project
        run: |
          if [ ! -d "android" ]; then
            ./node_modules/.bin/cap add android
          fi

      - name: Sync Capacitor
        run: ./node_modules/.bin/cap sync android

      - name: Build Android APK
        run: |
          chmod +x android/gradlew
          cd android
          ./gradlew assembleDebug --stacktrace

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: Klaytor-Debug-APK
          path: android/app/build/outputs/apk/debug/app-debug.apk
